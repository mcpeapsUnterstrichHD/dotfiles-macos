// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "context_servers": {
    "container-use-mcp": {
      "source": "extension",
      "enabled": true,
      "settings": {}
    },
    "browser-tools-context-server": {
      "source": "extension",
      "enabled": true,
      "settings": {}
    },
    "mcp-server-github": {
      "source": "extension",
      "enabled": true,
      "settings": {
        "github_personal_access_token": "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"
      }
    }
  },
  "icon_theme": "Modern Icons (Dark)",
  "minimap": {
    "show": "always"
  },
  "inlay_hints": {
    "enabled": true,
    "show_value_hints": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": {
      "control": false,
      "alt": false,
      "shift": false,
      "platform": false,
      "function": false
    }
  },
  "vim_mode": false,
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "formatter": "language_server",
  "theme": "comboom.sucht (Nordic)",
  "base_keymap": "VSCode",
  "ui_font_size": 12,
  "buffer_font_size": 12,
  "ui_font_family": "CaskaydiaCove Nerd Font Propo",
  "buffer_font_family": "CaskaydiaCove Nerd Font Mono",
  "lsp": {
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayParameterNameHintsWhenArgumentMatchesName": true,
          "includeInlayFunctionParameterTypeHints": true,
          "includeInlayVariableTypeHints": true,
          "includeInlayVariableTypeHintsWhenTypeMatchesName": false,
          "includeInlayPropertyDeclarationTypeHints": true,
          "includeInlayFunctionLikeReturnTypeHints": true,
          "includeInlayEnumMemberValueHints": true
        }
      }
    }
  },
  "terminal": {
    "alternate_scroll": "on",
    "blinking": "terminal_controlled",
    "copy_on_select": true,
    "env": {},
    "font_family": "CaskaydiaCove Nerd Font Mono",
    "font_size": 12,
    "option_as_meta": false,
    "shell": "system",
    "working_directory": "current_project_directory"
  }
}
