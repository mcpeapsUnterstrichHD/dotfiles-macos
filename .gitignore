# ===========================================
# macOS System Files
# ===========================================
.DS_Store
**/.DS_Store
.Spotlight-V100
.Trashes
._*

# ===========================================
# VS Code - Extensions sollten nicht getrackt werden
# ===========================================
.vscode/extensions/
.vscode/extensions-storage/

# ===========================================
# VS Kubernetes Tools (sehr groß)
# ===========================================
.vs-kubernetes/

# ===========================================
# Local / Cache Dateien
# ===========================================
# Python Virtual Environments
.local/xonsh-env/
.local/share/virtualenvs/

# Package Caches
.local/xonsh-env/pkgs/cache/

# Podman / Container Images (sehr groß!)
.local/share/containers/
.local/share/podman-desktop/

# NuGet Cache
.local/share/NuGet/

# NVim Mason packages (können neu installiert werden)
.local/share/nvim/mason/

# Trash
.local/share/Trash/

# Logs
.local/share/weechat/weechat.log
.local/share/weechat/logs/

# Docker scout cache
.docker/scout/

# ===========================================
# Secrets und sensible Daten
# ===========================================
.config/gh/hosts.yml
.config/github-copilot/hosts.json
.config/weechat/sec.conf
.ssh/id_*
.ssh/known_hosts
.ssh/*.pem

# ===========================================
# Raycast Extensions (groß, lokal installiert)
# ===========================================
.config/raycast/extensions/

# ===========================================
# IDE / Editor spezifisch
# ===========================================
*.swp
*.swo
*~
\#*\#
.\#*

# ===========================================
# Dotfiles Repo spezifisch
# ===========================================
.zsh-autopair
.zsh_sessions/

# ===========================================
# Python Cache
# ===========================================
__pycache__/
*.py[cod]
*.pyc
.Python
*.so

# ===========================================
# Node
# ===========================================
node_modules/
.npm/
.yarn/cache/

# ===========================================
# Große Binärdateien (allgemein)
# ===========================================
*.dylib
*.qcow2
*.qcow2.xz
*.jar
*.onnx
*.dat

# ===========================================
# atuin
# ===========================================
.local/share/atuin/history.db
.local/share/atuin/history.db-shm
.local/share/atuin/history.db-wal
.local/share/atuin/last_version_check_time
.local/share/atuin/records.db
.local/share/atuin/records.db-shm
.local/share/atuin/records.db-wal
.local/share/atuin/host_id
.local/share/atuin/key
.local/share/atuin/latest_version

# ===========================================
# xonsh
# ===========================================
.local/share/xonsh/history_json/**/*

# ===========================================
# Doom Emacs (Installation, nicht Config)
# ===========================================
.config/emacs/
.config/emacs.bak/

# ===========================================
# Neovim lazy plugins (werden automatisch installiert)
# ===========================================
.local/share/nvim/lazy/

# ===========================================
# Yazi plugins
# ===========================================
.config/yazi/plugins/
